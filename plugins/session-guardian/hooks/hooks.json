{
  "description": "Monitor Codex task size and safely roll oversized tasks into compact handoffs.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_guardian.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_guardian.py\" hook",
            "timeout": 5,
            "statusMessage": "Checking task size"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/session_guardian.py\" hook",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\session_guardian.py\" hook",
            "timeout": 10,
            "statusMessage": "Checking rollover threshold"
          }
        ]
      }
    ]
  }
}
